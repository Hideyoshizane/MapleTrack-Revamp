{
	"$schema": "https://json.schemastore.org/prettierrc",
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 120,
	"endOfLine": "lf",
	"singleQuote": true,
	"jsxSingleQuote": false,
	"semi": true,
	"trailingComma": "all",
	"arrowParens": "always",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"objectWrap": "collapse"
}
