generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model User {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @unique
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  version   Int      @default(1)
  lastLogin DateTime @default(now()) @db.Timestamptz(3)

  characters Character[]
  bossList   BossList?

  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime? @db.Timestamptz(3)

  liberations          Liberation[]
  liberationLastUpdate DateTime?    @db.Timestamptz(3)

  sessions Session[]
  accounts Account[]

  @@index([resetPasswordExpires])
}

model Character {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  level           Int
  targetLevel     Int
  class           String
  jobType         String
  legion          String
  linkSkill       String
  server          String
  lastUpdate      DateTime          @db.Timestamptz(3)
  lastSymbolDaily String?
  bossing         Boolean           @default(false)
  syncing         Boolean           @default(false)
  userId          String            @db.Uuid
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbols         CharacterSymbol[]
  bossCharacters  BossCharacter[]
  liberations     Liberation[]

  @@unique([userId, server, class])
  @@index([userId, name])
  @@index([server])
}

enum SymbolCategory {
  arcane
  sacred
  grand
}

model CharacterSymbol {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  level       Int
  exp         Int
  category    SymbolCategory
  characterId String             @db.Uuid
  character   Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  contents    CharacterContent[]

  @@unique([characterId, name])
}

model CharacterContent {
  id          String          @id @default(uuid()) @db.Uuid
  contentType String
  checked     Boolean         @default(false)
  cleared     Boolean         @default(false)
  date        DateTime?       @db.Timestamptz(3)
  symbolId    String          @db.Uuid
  symbol      CharacterSymbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([symbolId, contentType])
}

enum BossReset {
  Daily
  Weekly
  Monthly
}

model BossList {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @unique @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUpdateDaily   DateTime?    @db.Timestamptz(3)
  lastUpdateWeekly  DateTime?    @db.Timestamptz(3)
  lastUpdateMonthly DateTime?    @db.Timestamptz(3)
  servers           BossServer[]
}

model BossServer {
  id           String          @id @default(uuid()) @db.Uuid
  serverName   String
  weeklyBosses Int             @default(0)
  totalGains   Int             @default(0)
  bossListId   String          @db.Uuid
  bossList     BossList        @relation(fields: [bossListId], references: [id], onDelete: Cascade)
  characters   BossCharacter[]
}

model BossCharacter {
  id          String     @id @default(uuid()) @db.Uuid
  characterId String     @db.Uuid
  character   Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  serverId    String     @db.Uuid
  server      BossServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  bosses      Boss[]

  @@unique([serverId, characterId])
}

model Boss {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  difficulty      String
  reset           BossReset
  partySize       Int           @default(1)
  dailyTotal      Int?          @default(1)
  dailyCleared    Int?          @default(0)
  cleared         Boolean       @default(false)
  locked          Boolean?      @default(false)
  bossCharacterId String        @db.Uuid
  bossCharacter   BossCharacter @relation(fields: [bossCharacterId], references: [id], onDelete: Cascade)
}

model Liberation {
  id                         String    @id @default(uuid()) @db.Uuid
  userId                     String    @db.Uuid
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId                String    @db.Uuid
  character                  Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  server                     String
  currentGenesisQuest        String
  currentGenesisPoints       Int       @default(0)
  genesisPass                Boolean   @default(false)
  liberated                  Boolean   @default(false)
  currentAstraQuest          String
  currentAstraVestigesPoints Int       @default(0)
  currentAstraTracesPoints   Int       @default(0)
  currentDestinyQuest        String
  currentDestinyPoints       Int       @default(0)

  @@unique([userId, characterId])
  @@index([userId])
  @@index([characterId])
}
